# ==============================================================================
# Medi-Caps Competitive Programming Platform — Locust Load Testing Environment
# ==============================================================================

# Target Environment: local | staging | dev | production
LOAD_TEST_ENVIRONMENT=local

# Target Base URL (HTTP/HTTPS) — Do NOT use default production domain
LOAD_TEST_BASE_URL=http://localhost:8000

# Explicit safety gate for production targets
ALLOW_PRODUCTION_LOAD_TEST=false

# Virtual User Concurrency Configuration
LOAD_TEST_USERS=50
LOAD_TEST_SPAWN_RATE=5
LOAD_TEST_DURATION=10m

# Target Contest Slug (Leave empty to auto-discover or seed dynamic test contest)
LOAD_TEST_CONTEST_SLUG=weekly-contest-01

# Default programming language for synthetic submissions: python | cpp | java | javascript
LOAD_TEST_DEFAULT_LANGUAGE=python

# User Identity Namespace Prefix (All test users and records will use this namespace)
LOAD_TEST_USERNAME_PREFIX=loadtest_student
LOAD_TEST_USER_DOMAIN=medicaps.ac.in

# Request Timeouts & Polling Caps (seconds)
LOAD_TEST_TIMEOUT_SECONDS=30
LOAD_TEST_SUBMISSION_POLL_TIMEOUT=20

# Database & Redis access for test data provisioning (seed/cleanup scripts only)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arena_dev
REDIS_URL=redis://localhost:6379/0

# Reporting & Output Directory
LOAD_TEST_REPORT_DIR=tests/load/reports

# CCC Medi-Caps Arena API — Environment Template
PROJECT_NAME="CCC Medi-Caps Arena API"
VERSION=1.0.0
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

SECRET_KEY=your-32-character-secret-key-here
# Asymmetric RSA keys for RS256 JWT tokens (paste PEM or set file paths)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OTP_EXPIRE_MINUTES=10
# Database (PostgreSQL 16+ via asyncpg)
# Default local dev: postgresql+asyncpg://postgres:postgres@localhost:5432/ccc_medicaps
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ccc_medicaps
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Cloudflare Client Security & Turnstile
CLOUDFLARE_TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@chaoscomputerclub.in
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@chaoscomputerclub.in
SMTP_FROM_NAME="Chaos Computer Club"

FRONTEND_URL=http://localhost:8081
BACKEND_URL=http://localhost:8000

# Code Execution Engine — CodeBox (Judge0-compatible engine)
JUDGE_PROVIDER=codebox
CODEBOX_URL=http://127.0.0.1:3000
CODEBOX_TOKEN=dev-token
INTERLEET_ENGINE_URL=http://127.0.0.1:8001

# Dynamic Development Testing Controls (Set to true in local testing only to bypass timing windows and arena restrictions)
DEV_BYPASS_RESTRICTIONS=false
DEV_MODE=false
DISABLE_MAIL_DISPATCH=false

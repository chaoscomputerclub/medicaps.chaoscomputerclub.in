# CCC Medi-Caps Arena API — Environment Template
PROJECT_NAME="CCC Medi-Caps Arena API"
VERSION=1.0.0
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

SECRET_KEY=your-32-character-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_MINUTES=10

DATABASE_URL=sqlite+aiosqlite:///./ccc_medicaps.db

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@chaoscomputerclub.in
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@chaoscomputerclub.in
SMTP_FROM_NAME="Chaos Computer Club"

FRONTEND_URL=http://localhost:8081
BACKEND_URL=http://localhost:8000

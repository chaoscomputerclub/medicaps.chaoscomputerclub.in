# ==============================================================================
# Chaos Computer Club Medi-Caps Chapter — Portable Compute Node Configuration
# ==============================================================================

# Central Control Plane URL (Cloud VPS or local cluster endpoint)
CONTROL_PLANE_URL=https://medicaps-api.chaoscomputerclub.in

# Enrollment secret token (Matches JUDGE_AGENT_SECRET on Control Plane)
ENROLLMENT_TOKEN=ccc_judge_agent_secret_prod_2026

# RAM tmpfs base workspace for isolated Docker testcase executions
WORKSPACE_BASE=/tmp/ccc_workspaces
USE_RAM_TMPFS=true

# Local serving ports
STATIC_PORT=8085
DIST_DIR=./dist

# Governor thresholds
HEARTBEAT_INTERVAL_S=5
MAX_CPU_THRESHOLD_PCT=85.0
MIN_MEMORY_HEADROOM_MB=1024

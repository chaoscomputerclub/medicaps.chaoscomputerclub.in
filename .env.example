# CCC Medi-Caps Frontend Environment Template
# Default: /api (routes through same-origin reverse proxy, zero backend exposure)
# Set to custom URL only if connecting directly to a remote/staging API
VITE_API_URL=/api

# Cloudflare Turnstile Client Security
# (Default uses Cloudflare's official always-pass testing key)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

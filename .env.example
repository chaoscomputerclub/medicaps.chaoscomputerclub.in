# CCC Medi-Caps Frontend Environment Template
VITE_ENV=development

# API Endpoint:
# - Production: /api (routes through same-origin reverse proxy)
# - Local frontend -> Production backend: https://medicaps.chaoscomputerclub.in/api
# - Local frontend -> Local backend: http://localhost:8000/api
VITE_API_URL=/api

# Application Canonical Origin (defaults dynamically to window.location.origin)
# VITE_APP_URL=https://medicaps.chaoscomputerclub.in

# Cloudflare Turnstile Client Security (Default uses Cloudflare's official always-pass testing key)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Contact & Chapter Email
VITE_CONTACT_EMAIL=info@chaoscomputerclub.in

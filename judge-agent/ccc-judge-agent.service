# systemd service unit for the CCC Judge Agent
# Install: sudo cp ccc-judge-agent.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable ccc-judge-agent
#          sudo systemctl start ccc-judge-agent

[Unit]
Description=Chaos Computer Club — Portable Compute Fabric Node Agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=santusht
Group=docker
WorkingDirectory=/opt/ccc-judge-agent
EnvironmentFile=-/opt/ccc-judge-agent/.env
ExecStart=/opt/ccc-judge-agent/bin/node-agent-linux-amd64
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=25

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccc-judge-agent

[Install]
WantedBy=multi-user.target

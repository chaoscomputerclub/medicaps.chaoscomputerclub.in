# ==============================================================================
# Chaos Computer Club — Universal Multi-Language Judge Sandbox Container
# Compatible with: Railway, Render, Koyeb, Google Cloud Run, Fly.io, Bare-Metal
#
# Compilers & Runtimes:
# - C (GCC 13 / 14 - C11)
# - C++ (G++ 13 / 14 - C++20)
# - Java 21 (OpenJDK Headless)
# - Python 3.12
# - JavaScript (Node.js 20 LTS)
# - TypeScript (Node.js 20 LTS + tsc compiler)
# ==============================================================================

FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

WORKDIR /app

# Install system compilers & execution runtimes (C/C++, Java, Node.js, TypeScript)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    g++ \
    default-jdk-headless \
    nodejs \
    npm \
    ca-certificates \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install global TypeScript compiler
RUN npm install -g typescript

# Create virtualenv for FastAPI judge service
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir fastapi uvicorn pydantic httpx

# Create unprivileged sandbox execution user
RUN groupadd -g 2000 sandbox && \
    useradd -u 2000 -g sandbox -m -s /bin/bash sandbox

# Copy judge server engine
COPY infra/cloudrun-judge/server.py /app/server.py

# Ensure permissions
RUN chown -R sandbox:sandbox /app

EXPOSE 8080

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Launch Judge HTTP API dynamically binding to $PORT
CMD ["sh", "-c", "uvicorn server:app --host 0.0.0.0 --port ${PORT:-8080} --workers 2"]

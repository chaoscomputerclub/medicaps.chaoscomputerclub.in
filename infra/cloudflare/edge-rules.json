{
  "description": "Cloudflare Edge Cache and WAF Rules for Fabric",
  "cache_rules": [
    {
      "expression": "(http.request.uri.path starts_with \"/assets/\")",
      "action": "cache",
      "edge_ttl": 31536000,
      "browser_ttl": 31536000,
      "cache_deception_armor": true
    },
    {
      "expression": "(http.request.uri.path eq \"/index.html\" or http.request.uri.path eq \"/\")",
      "action": "bypass"
    },
    {
      "expression": "(http.request.uri.path starts_with \"/api/\")",
      "action": "bypass"
    }
  ],
  "rate_limiting": [
    {
      "expression": "(http.request.uri.path starts_with \"/api/contests/\" and http.request.uri.path contains \"/submit\")",
      "threshold": 10,
      "period": 60,
      "action": "challenge"
    },
    {
      "expression": "(http.request.uri.path starts_with \"/api/auth/\")",
      "threshold": 20,
      "period": 60,
      "action": "block"
    }
  ]
}

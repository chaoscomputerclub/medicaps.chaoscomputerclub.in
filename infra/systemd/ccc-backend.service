[Unit]
Description=CCC Control Plane & Global Fabric Router
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/medicaps/backend
Environment="PATH=/var/www/medicaps/backend/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/var/www/medicaps/backend/.env
ExecStart=/var/www/medicaps/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers
Restart=always
RestartSec=3s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

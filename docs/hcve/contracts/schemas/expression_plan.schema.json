{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcve.local/schemas/expression-plan-1.0.json",
  "title": "HCVE Expression Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "text",
    "language",
    "personality",
    "expression",
    "voice",
    "rendering"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "object",
      "required": [
        "locale"
      ],
      "properties": {
        "locale": {
          "type": "string"
        },
        "pronunciation_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "code_switching": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "personality": {
      "type": "object",
      "required": [
        "profile_id"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "expression": {
      "type": "object",
      "required": [
        "tone",
        "emotion",
        "delivery",
        "prosody"
      ],
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "casual",
            "serious",
            "professional",
            "reassuring",
            "curious",
            "empathetic",
            "assertive"
          ]
        },
        "emotion": {
          "type": "object",
          "required": [
            "label",
            "strength"
          ],
          "properties": {
            "label": {
              "type": "string",
              "enum": [
                "neutral",
                "happy",
                "concerned",
                "curious",
                "sad",
                "excited",
                "calm",
                "frustrated"
              ]
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "delivery": {
          "type": "object",
          "required": [
            "energy",
            "warmth",
            "formality",
            "pace",
            "expressiveness",
            "volume"
          ],
          "properties": {
            "energy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "warmth": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "formality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pace": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "expressiveness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "prosody": {
          "type": "object",
          "properties": {
            "speaking_style": {
              "type": "string",
              "enum": [
                "conversational",
                "narrative",
                "explanatory",
                "announcing",
                "whispered",
                "measured"
              ]
            },
            "pitch_variation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pauses_ms": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2000
              }
            },
            "emphasis_spans": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "start",
                  "end",
                  "strength"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "required": [
        "provider",
        "voice_id"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "voice_id": {
          "type": "string"
        },
        "consistency_profile": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "rendering": {
      "type": "object",
      "required": [
        "streaming",
        "allow_interruption"
      ],
      "properties": {
        "streaming": {
          "type": "boolean"
        },
        "allow_interruption": {
          "type": "boolean"
        },
        "segment_strategy": {
          "type": "string",
          "enum": [
            "sentence",
            "phrase",
            "provider_native"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
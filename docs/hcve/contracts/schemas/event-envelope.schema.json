{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HCVE Event Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "session_id",
    "timestamp",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "response_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
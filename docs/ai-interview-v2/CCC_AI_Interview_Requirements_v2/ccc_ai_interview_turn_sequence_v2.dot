
digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.28", ranksep="0.35", labelloc="t", label="Answer Turn — Request to Durable Response", fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f8fa", color="#586174", fontname="Arial", fontsize=9.5, margin="0.14,0.08"];
  edge [color="#586174", arrowsize=0.7, fontname="Arial", fontsize=9];
  A [label="Candidate submits answer + idempotency key"];
  B [label="FastAPI authenticates and checks ownership"];
  C [label="Check committed idempotency key + session version"];
  D [label="Resume LangGraph from valid checkpoint"];
  E [label="Analyze answer and select next action"];
  F [label="Validate typed output and transition policy"];
  G [label="Commit answer + evaluation + next question + checkpoint"];
  H [label="Return committed response to UI"];
  A -> B -> C -> D -> E -> F -> G -> H;
}